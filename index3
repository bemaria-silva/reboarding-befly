{name:'Belvitur',short:'Há 60 anos no turismo, alcançou o posto de maior agência multimarcas do Brasil, reunindo soluções para viajantes.',full:'Agência de viagens completa B2B e B2C.',bullets:['Viagens de lazer para pessoas físicas','Pacotes nacionais e internacionais','Viagens corporativas para empresas','Atendimento consultivo e personalizado'],url:'https://belvitur.com.br'},
{name:'Viptrip',short:'Tecnologia para otimizar a gestão de viagens corporativas, incentivo e eventos, com mais agilidade e menos custo.',full:'Viagens de incentivo e experiências premium para empresas.',bullets:['Incentivo corporativo','Experiências exclusivas e personalizadas','Ações de relacionamento','Projetos sob medida para empresas'],url:'https://viptrip.com.br'},
{name:'Flytour Eventos',short:'Especializada em eventos corporativos, viagens de incentivo e premiações, cuidando de logística e negociações com fornecedores.',full:'Soluções de eventos corporativos, incentivo e premiações.',bullets:[],url:'https://eventos.flytour.com.br'},
{name:'Flytour Viagens',short:'Agência de viagens e negócios com atuação nacional, atendendo empresas que buscam expandir seus negócios pelo mundo.',full:'Soluções para viagens corporativas e negócios.',bullets:[],url:'https://flytour.com.br'}]}
];
const POSTS=[['Cultura BeFly','Cultura','#OuseEFaçaAcontecer. Você já conheceu a trajetória da Maria Alice?'],['Novo benefício disponível!','Benefícios','Acesse a plataforma de bem-estar emocional com atendimento online e conteúdos exclusivos.'],['Desenvolvimento','Treinamento','Inscrições abertas para Excel Avançado e Power BI em parceria com o SENAI.'],['Oportunidade Interna','Recrutamento Interno','Analista de Dados Pleno — Tecnologia. Inscrições abertas até 22/10.'],['Minha Ideia Voa','Reconhecimento','Parabéns aos participantes! Projetos com criatividade, colaboração e foco em melhoria contínua.']];
let state=JSON.parse(localStorage.getItem('beflyReboarding')||'null')||{participant:null,visited:{},xp:0,impresa:[],quizDone:false};
const save=()=>localStorage.setItem('beflyReboarding',JSON.stringify(state));
const app=document.getElementById('app'), overlay=document.getElementById('overlay');
function logo(light=false){return `<div class="brand" style="${light?'color:#fff':''}"><span class="brand-mark"></span><span>BEFLY</span></div>`}
function initials(n){return (n||'BF').split(' ').slice(0,2).map(x=>x[0]).join('').toUpperCase()}
function showWelcome(){app.innerHTML=`<section class="screen welcome"><div class="welcome-inner"><div class="hero">${logo()}<div class="eyebrow" style="margin-top:70px">REBOARDING BEFLY · JORNADA 2026</div><h1>Seu próximo<br>destino <span>começa aqui.</span></h1><p>Uma jornada pelo ecossistema BeFly. Faça seu check-in, explore nossos destinos e descubra as marcas que fazem essa viagem acontecer.</p><button class="btn btn-primary" onclick="showCheckin()">Fazer check-in →</button></div><div class="airport-card"><div class="eyebrow">DEPARTURES</div><h2 style="font-family:'Space Grotesk';font-size:32px;margin:12px 0 0">BEFLY AIRPORT</h2><div class="flight-mini"><div><small>Origem</small><strong>BEFLY</strong></div><div class="plane">✈</div><div style="text-align:right"><small>Destino</small><strong>∞</strong></div></div><div style="margin-top:22px;color:#b9c8d6;line-height:1.6;font-size:14px">Prepare-se para embarcar em uma experiência de desenvolvimento, conexão e descoberta.</div></div></div></section>`}
function showCheckin(){app.innerHTML=`<section class="screen form-page"><div class="form-wrap"><div class="form-head">${logo(true)}<span style="font-size:12px;color:#aabaca;letter-spacing:.1em">CHECK-IN</span></div><div class="form-panel"><div class="eyebrow">PASSAGEIRO</div><h2>Vamos preparar seu embarque.</h2><p>Preencha seus dados para iniciar sua jornada pelo ecossistema BeFly.</p><div class="fields"><div class="field"><label>Nome completo</label><input id="name" placeholder="Digite seu nome"></div><div class="field"><label>E-mail corporativo</label><input id="email" type="email" placeholder="nome@befly.com.br"></div><div class="field"><label>Área / Diretoria</label><input id="area" placeholder="Ex.: Gente & Gestão"></div><div class="field"><label>Data</label><input id="date" type="date" value="${new Date().toISOString().slice(0,10)}"></div></div><div class="form-actions"><button id="continueBtn" class="btn btn-primary" disabled onclick="submitCheckin()">Confirmar check-in →</button></div></div></div></section>`;['name','email','area','date'].forEach(id=>document.getElementById(id).addEventListener('input',validate));}
function validate(){const ok=['name','email','area','date'].every(id=>document.getElementById(id).value.trim());document.getElementById('continueBtn').disabled=!ok}
function submitCheckin(){state.participant={name:document.getElementById('name').value.trim(),email:document.getElementById('email').value.trim(),area:document.getElementById('area').value.trim(),date:document.getElementById('date').value};save();showHall()}
function gateStatus(g,i){if(state.visited[g.id]?.length===g.units.length)return 'done';if(i===0||GATES[i-1]&&state.visited[GATES[i-1].id]?.length===GATES[i-1].units.length)return 'ready';return 'wait'}
function showHall(){if(!state.participant){showWelcome();return}const p=state.participant;const completed=GATES.filter(g=>state.visited[g.id]?.length===g.units.length).length;app.innerHTML=`<section class="screen hall"><div class="topbar"><div class="topbar-inner">${logo()}<div class="user-chip"><span>${p.name}</span><span class="avatar">${initials(p.name)}</span></div></div></div><div class="shell"><div class="hero-hall"><div><div class="eyebrow">BOA VIAGEM, ${p.name.split(' ')[0].toUpperCase()}</div><h2>Hall de Embarque</h2><p>Seu aeroporto para explorar o ecossistema BeFly.</p></div><div class="progress-box"><div class="row"><span>JORNADA</span><span>${completed}/5 destinos</span></div><div class="progress"><i style="width:${completed*20}%"></i></div></div></div><div class="board"><div class="board-head"><div><div class="board-title">✦ DEPARTURES</div><div class="board-sub">Painel de embarque · BeFly Airport</div></div><div class="board-sub">${new Date().toLocaleDateString('pt-BR')}</div></div>${GATES.map((g,i)=>{const s=gateStatus(g,i),visited=state.visited[g.id]?.length||0;return `<div class="flight-row"><div class="code">${g.flight}</div><div class="destination"><strong>${g.destination}</strong><small>Portão ${g.num} · ${g.name}</small></div><div class="status-col"><span class="status ${s}">${s==='done'?'VOO DECOLADO':s==='ready'?'EMBARQUE ABERTO':'AGUARDANDO'}</span></div><div class="gate-col" style="color:#a9bacb;font-size:12px">${visited}/${g.units.length} explorados</div><button class="gate-btn" ${s==='wait'?'disabled':''} onclick="openBoarding('${g.id}')">${s==='done'?'REVER':'EMBARCAR'}</button></div>`}).join('')}</div><h3 class="section-title">Experiências do aeroporto</h3><div class="explore-grid"><div class="feature"><div class="icon">▣</div><h3>Impresa</h3><p>Explore notícias, cultura, benefícios e oportunidades internas.</p><button class="btn btn-ghost" onclick="showImpresa()">Acessar →</button></div><div class="feature"><div class="icon">◷</div><h3>Cafeteria</h3><p>Faça uma pausa de 15 minutos antes de seguir viagem.</p><button class="btn btn-ghost" onclick="showCoffee()">Entrar →</button></div><div class="feature"><div class="icon">✦</div><h3>Quiz de bordo</h3><p>Teste o que você descobriu e acumule pontos na jornada.</p><button class="btn btn-ghost" onclick="showQuiz()">Começar →</button></div></div><div style="display:flex;justify-content:center;margin-top:42px"><button class="btn btn-primary" ${completed<5?'disabled':''} onclick="showCertificate()">Finalizar Jornada →</button></div></div></section>`}
function openBoarding(id){const g=GATES.find(x=>x.id===id);overlay.classList.remove('hidden');overlay.innerHTML=`<div class="modal"><div class="modal-head"><strong>Embarque autorizado</strong><button class="close" onclick="closeOverlay()">×</button></div><div class="boarding"><div class="boarding-pass"><div class="bp-top"><div class="bp-brand">BEFLY · BOARDING PASS</div></div><div class="bp-main"><div class="eyebrow">VOO ${g.flight}</div><h2 class="bp-code">${g.num}</h2><div class="bp-dest">${g.name} · ${g.destination}</div><div class="bp-grid"><div><small>Passageiro</small><strong>${state.participant.name}</strong></div><div><small>Portão</small><strong>${g.num}</strong></div><div><small>Destino</small><strong>${g.destination}</strong></div><div><small>Status</small><strong>Embarque aberto</strong></div></div></div></div><div class="boarding-side"><div><div class="eyebrow">PRÓXIMA PARADA</div><h3>${g.destination}</h3><p>Confirme seu embarque para acessar o ambiente de ${g.name} e explorar todas as unidades deste destino.</p></div><button class="btn btn-primary" onclick="enterGate('${g.id}')">Confirmar embarque →</button></div></div></div>`}
function enterGate(id){closeOverlay();showGate(id)}
function showGate(id){const g=GATES.find(x=>x.id===id);if(!state.visited[id])state.visited[id]=[];save();app.innerHTML=`<section class="screen hall"><div class="topbar"><div class="topbar-inner">${logo()}<div class="user-chip"><span>Portão ${g.num} · ${g.name}</span><span class="avatar">${initials(state.participant.name)}</span></div></div></div><div class="shell"><div class="gate-intro" style="border-radius:18px;margin-top:18px"><div class="eyebrow">PORTÃO ${g.num} · ${g.flight}</div><h2>${g.name}</h2><p>Destino: ${g.destination} · Explore todas as unidades para concluir o embarque.</p></div><div class="unit-grid">${g.units.map((u,i)=>{const v=state.visited[id].includes(i);return `<article class="unit ${v?'visited':''}"><div class="unit-head"><h3>${u.name}</h3>${v?'<span class="check">✓ VISITADO</span>':''}</div><p>${u.short}</p><div class="unit-actions"><button class="btn ${v?'btn-ghost':'btn-dark'}" onclick="visitUnit('${id}',${i})">${v?'Rever':'Explorar'} →</button></div>${v?`<div class="details"><strong>${u.full}</strong>${u.bullets.length?'<ul>'+u.bullets.map(x=>`<li>${x}</li>`).join('')+'</ul>':''}<a href="${u.url}" target="_blank" rel="noopener" style="color:var(--orange);font-weight:700;text-decoration:none">Conhecer site oficial ↗</a></div>`:''}</article>`}).join('')}</div><div class="unit-footer"><div class="unit-progress"><strong>${state.visited[id].length}/${g.units.length}</strong> destinos explorados · ${state.visited[id].length===g.units.length?'Você pode decolar!':'Explore todos os destinos para liberar a saída.'}</div><button class="btn ${state.visited[id].length===g.units.length?'btn-primary':'btn-ghost'}" ${state.visited[id].length!==g.units.length?'disabled':''} onclick="leaveGate('${id}')">${state.visited[id].length===g.units.length?'Voltar ao Hall ✈':'Concluir exploração'}</button></div></div></section>`}
function visitUnit(id,i){if(!state.visited[id].includes(i)){state.visited[id].push(i);state.xp+=10;save()}showGate(id)}
function leaveGate(id){showHall()}
function closeOverlay(){overlay.classList.add('hidden');overlay.innerHTML=''}
function showImpresa(){app.innerHTML=`<section class="screen hall"><div class="topbar"><div class="topbar-inner">${logo()}<button class="btn btn-ghost" onclick="showHall()">← Hall</button></div></div><div class="shell"><div class="eyebrow">IMPRESA | GENTE & GESTÃO</div><h2 style="font-family:'Space Grotesk';font-size:42px;color:var(--navy);margin:8px 0">Conectando pessoas, cultura e desenvolvimento.</h2><div class="page-card"><input id="postSearch" placeholder="Buscar conteúdo..." oninput="renderPosts()" style="width:100%;padding:13px;border:1px solid var(--line);border-radius:9px"><div class="filters">${['Todos','Cultura','Treinamento','Benefícios','Recrutamento Interno','Reconhecimento'].map((x,i)=>`<button class="filter ${i===0?'active':''}" onclick="setFilter(this,'${x}')">${x}</button>`).join('')}</div><div id="posts" class="posts"></div></div></div></section>`;window.impFilter='Todos';renderPosts()}
function setFilter(btn,x){document.querySelectorAll('.filter').forEach(b=>b.classList.remove('active'));btn.classList.add('active');window.impFilter=x;renderPosts()}
function renderPosts(){const q=(document.getElementById('postSearch')?.value||'').toLowerCase();const list=POSTS.filter(p=>(window.impFilter==='Todos'||p[1]===window.impFilter)&&(!q||p.join(' ').toLowerCase().includes(q)));document.getElementById('posts').innerHTML=list.map((p,i)=>`<article class="post"><div class="eyebrow">${p[1]}</div><h3>${p[0]}</h3><p>${p[2]}</p><div class="post-actions">${['♥ Curtir','✦ Inspirador','🚀 Quero participar','☆ Salvar'].map((x,j)=>`<button onclick="postReact(${i},${j},this)">${x}</button>`).join('')}</div></article>`).join('')||'<p>Nenhum conteúdo encontrado.</p>'}
function postReact(i,j,b){const key=i+'-'+j;if(!state.impresa.includes(key)){state.impresa.push(key);state.xp+=10;save();b.classList.add('active');b.textContent+=' ✓'}}
let coffeeTimer=900,coffeeInterval=null;function showCoffee(){app.innerHTML=`<section class="screen hall"><div class="topbar"><div class="topbar-inner">${logo()}<button class="btn btn-ghost" onclick="showHall()">← Hall</button></div></div><div class="shell"><div class="page-card coffee"><div class="eyebrow">LOUNGE</div><h2 style="font-family:'Space Grotesk';font-size:40px;color:var(--navy)">Cafeteria BeFly</h2><p style="color:var(--muted)">Uma pausa de 15 minutos antes do próximo embarque.</p><div id="clock" class="clock">15:00</div><button id="coffeeBtn" class="btn btn-primary" onclick="toggleCoffee()">Iniciar pausa</button><button class="btn btn-ghost" style="margin-left:8px" onclick="showHall()">Voltar ao Hall</button></div></div></section>`;coffeeTimer=900;clearInterval(coffeeInterval)}
function toggleCoffee(){const b=document.getElementById('coffeeBtn');if(coffeeInterval){clearInterval(coffeeInterval);coffeeInterval=null;b.textContent='Continuar pausa'}else{b.textContent='Pausar';coffeeInterval=setInterval(()=>{coffeeTimer--;document.getElementById('clock').textContent=`${String(Math.floor(coffeeTimer/60)).padStart(2,'0')}:${String(coffeeTimer%60).padStart(2,'0')}`;if(coffeeTimer<=0){clearInterval(coffeeInterval);coffeeInterval=null;b.textContent='Pausa concluída'}} ,1000)}}
const QUESTIONS=[['Qual destes destinos está ligado ao Portão Transformação?',['Tecnologia','Agentes de Viagens','Pessoa Física','Pessoa Jurídica'],1],['Qual unidade aparece no Portão Inovação?',['STB','OpenTrips','Belvitur','Viptrip'],1],['O STB é especialista em quê?',['Seguro viagem','Educação internacional','Cruzeiros','Eventos corporativos'],1],['Qual marca é focada em ecoturismo e aventura?',['Desviantes','QBY','Reservia','Consolidadora'],0],['Qual unidade pertence ao destino Pessoa Jurídica?',['Instaviagem','Melhor Seguro','Viptrip','Vai Voando'],2],['Quantos portões compõem a jornada principal?',['3','4','5','6'],2]];let qi=0,qscore=0,qtimer=null,qseconds=15;
function showQuiz(){qi=0;qscore=0;renderQuestion()}
function renderQuestion(){if(qi>=QUESTIONS.length){state.quizDone=true;state.xp+=qscore;save();app.innerHTML=`<section class="screen hall"><div class="topbar"><div class="topbar-inner">${logo()}<button class="btn btn-ghost" onclick="showHall()">← Hall</button></div></div><div class="shell"><div class="page-card quiz-box" style="text-align:center"><div class="eyebrow">QUIZ DE BORDO</div><h2 style="font-family:'Space Grotesk';font-size:45px;color:var(--navy)">Jornada concluída</h2><p style="font-size:20px;color:var(--muted)">Você acertou <strong>${qscore/10}</strong> de ${QUESTIONS.length} perguntas.</p><div style="font-family:'Space Grotesk';font-size:60px;color:var(--orange)">${qscore} XP</div><button class="btn btn-primary" onclick="showHall()">Voltar ao Hall →</button></div></div></section>`;return}const q=QUESTIONS[qi];qseconds=15;app.innerHTML=`<section class="screen hall"><div class="topbar"><div class="topbar-inner">${logo()}<button class="btn btn-ghost" onclick="showHall()">← Hall</button></div></div><div class="shell"><div class="page-card quiz-box"><div class="quiz-meta"><span>QUESTÃO ${qi+1}/${QUESTIONS.length}</span><span class="timer" id="qtime">00:15</span></div><h2 class="quiz-question">${q[0]}</h2><div class="answers">${q[1].map((a,i)=>`<button class="answer" onclick="answer(${i},this)">${a}</button>`).join('')}</div></div></div></section>`;clearInterval(qtimer);qtimer=setInterval(()=>{qseconds--;const el=document.getElementById('qtime');if(el)el.textContent='00:'+String(qseconds).padStart(2,'0');if(qseconds<=0){clearInterval(qtimer);answer(-1,null)}},1000)}
function answer(i,b){clearInterval(qtimer);const q=QUESTIONS[qi];document.querySelectorAll('.answer').forEach((x,idx)=>{if(idx===q[2])x.classList.add('correct');if(idx===i&&i!==q[2])x.classList.add('wrong');x.disabled=true});if(i===q[2])qscore+=10;setTimeout(()=>{qi++;renderQuestion()},650)}
function showCertificate(){const p=state.participant;app.innerHTML=`<section class="screen hall"><div class="topbar"><div class="topbar-inner">${logo()}<button class="btn btn-ghost" onclick="showHall()">← Hall</button></div></div><div class="shell"><div class="certificate"><div class="eyebrow">BEFLY · REBOARDING</div><h1>Certificado de Jornada</h1><p>Certificamos que</p><div class="name">${p.name}</div><p>concluiu a jornada de Reboarding BeFly, explorando os destinos e unidades do ecossistema.</p><p><strong>${new Date().toLocaleDateString('pt-BR')}</strong></p><div style="margin-top:35px"><button class="btn btn-primary" onclick="window.print()">Baixar / Imprimir certificado</button></div></div></div></section>`}
if(state.participant)showHall();else showWelcome();
</script>
</body>
